# Whisper
WHISPER_MODEL=base
DEVICE=cpu

# Extraction provider — swap without changing any pipeline code
EXTRACTOR_PROVIDER=regex   # regex | ollama | bedrock | anthropic

# Ollama (when EXTRACTOR_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# AWS Bedrock (when EXTRACTOR_PROVIDER=bedrock)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Anthropic (when EXTRACTOR_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/careficient

LOG_LEVEL=INFO
DEBUG=false
