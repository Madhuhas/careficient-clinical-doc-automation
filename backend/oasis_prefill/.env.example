# OASIS Prefill Module Configuration

# Form Version
OASIS_FORM_VERSION=E1
OASIS_ENABLE_E2=true

# Confidence Thresholds
OASIS_MIN_CONFIDENCE_VALID=0.50
OASIS_MIN_CONFIDENCE_PARTIAL=0.25

# Field Requirements
OASIS_MIN_FIELDS_VALID=25
OASIS_MIN_FIELDS_PARTIAL=12

# Confidence Calculation Weights
OASIS_EXTRACTION_WEIGHT=0.6
OASIS_FIELD_FILL_WEIGHT=0.4

# Database Configuration
OASIS_USE_DATABASE=false
DATABASE_URL=sqlite:///oasis.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/oasis

# AWS Configuration
OASIS_USE_AWS=false
AWS_S3_BUCKET=oasis-forms
AWS_REGION=us-east-1

# Logging
OASIS_LOG_LEVEL=INFO
OASIS_LOG_FILE=logs/oasis.log

# API Configuration
OASIS_API_PORT=8003
OASIS_API_HOST=0.0.0.0
OASIS_DEBUG=false

# Batch Processing
OASIS_BATCH_SIZE=10
OASIS_MAX_BATCH_SIZE=100
OASIS_BATCH_TIMEOUT=300

# Field Mappings
# OASIS_CUSTOM_MAPPINGS=/path/to/custom_mappings.json

# CMS Compliance
OASIS_CMS_VALIDATION=true
OASIS_AUDIT_TRAIL=true
